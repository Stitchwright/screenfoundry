<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.stitchwright.stitchfoundry</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>StitchFoundry</name>
  <summary>Separate artwork into films for screen printing</summary>
  <developer id="com.stitchwright">
    <name>SiteSentrix</name>
  </developer>
  <description>
    <p>
      StitchFoundry is an open-source screen-printing prepress app built on a full vector editor.
      Separate artwork into one film per screen, with an underbase, trapping, halftones and
      registration marks. It is based on VectorCraft.
    </p>
  </description>
  <launchable type="desktop-id">com.stitchwright.stitchfoundry.desktop</launchable>
  <icon type="stock">com.stitchwright.stitchfoundry</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Stitchwright/StitchFoundry</url>
  <url type="bugtracker">https://github.com/Stitchwright/StitchFoundry/issues</url>
  <url type="help">https://github.com/Stitchwright/StitchFoundry</url>
  <categories>
    <category>Graphics</category>
    <category>2DGraphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>screen printing</keyword>
    <keyword>silkscreen</keyword>
    <keyword>separations</keyword>
    <keyword>halftone</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#f6c3cb</color>
    <color type="primary" scheme_preference="dark">#1e2b4f</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>stitchfoundry</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
