[Desktop Entry]
Type=Application
Name=StitchFoundry
GenericName=Screen Printing Prepress
Comment=Separate artwork into films for screen printing
Exec=stitchfoundry %F
TryExec=stitchfoundry
Icon=com.stitchwright.stitchfoundry
Terminal=false
StartupNotify=true
StartupWMClass=com.stitchwright.stitchfoundry
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=screen printing;silkscreen;separations;halftone;vector;svg;
# MimeType lists the formats File › Open reads that Info.plist.in declares for macOS. The type of .ai
# files is shared-mime-info's application/illustrator (brand-ok).
MimeType=image/svg+xml;application/pdf;application/x-stitchfoundry;application/x-vectorcraft;image/svg+xml-compressed;application/illustrator;application/x-ai-template;image/png;image/jpeg;image/gif;image/webp;image/tiff;image/bmp;application/x-vectorcraft-template;image/vnd.dxf;image/emf;image/wmf;image/x-eps;application/x-affinity;
